{
  "name": "fix-youtube-playlist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "client": "vite",
    "dev": "npm run server & npm run client",
    "lint": "npx eslint .",
    "login": "npx tsx configureEnv --login",
    "playwright": "(cd playwright; npx playwright test)",
    "prettier": "npx prettier -w .",
    "preview": "vite preview",
    "server": "npx tsx server/app.ts",
    "set-code": "npx tsx configureEnv --code",
    "start": "sh start.sh"
  },
  "dependencies": {
    "@googleapis/youtube": "34.1.0",
    "@solid-primitives/script-loader": "2.3.2",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "google-auth-library": "11.0.2",
    "googleapis": "176.0.0",
    "ky": "2.0.2",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/youtube": "0.3.0",
    "eslint": "10.9.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vite-plugin-solid": "2.11.14"
  }
}
