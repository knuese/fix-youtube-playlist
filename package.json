{
  "name": "fix-youtube-playlist",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "client": "vite",
    "dev": "npm run server & npm run client",
    "format": "npx oxfmt .",
    "lint": "npx oxlint .",
    "login": "npx tsx configureEnv --login",
    "playwright": "(cd playwright; npx playwright test)",
    "preview": "vite preview",
    "server": "npx tsx server/app.ts",
    "set-code": "npx tsx configureEnv --code",
    "start": "sh start.sh"
  },
  "dependencies": {
    "@googleapis/youtube": "34.1.0",
    "@solid-primitives/script-loader": "2.3.2",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "google-auth-library": "11.0.2",
    "googleapis": "176.0.0",
    "ky": "2.0.2",
    "solid-js": "1.9.18"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/youtube": "0.3.0",
    "globals": "17.11.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.90.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.14"
  }
}
